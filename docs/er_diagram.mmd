erDiagram
    USERS ||--o{ BUILDS : "owns (cascade)"
    USERS ||--o{ LOGIN_SESSIONS : "has (cascade)"
    CATEGORIES ||--o{ COMPONENTS : "groups (restrict)"
    BUILDS ||--o{ BUILD_ITEMS : "contains (cascade)"
    COMPONENTS ||--o{ BUILD_ITEMS : "selected in (restrict)"

    USERS {
        INTEGER id PK
        TEXT username UK "required"
        TEXT password_hash "required"
        TEXT role "student or admin"
    }
    LOGIN_SESSIONS {
        TEXT token_digest PK
        INTEGER user_id FK "required"
        INTEGER expires_at "Unix seconds"
    }
    CATEGORIES {
        INTEGER id PK
        TEXT name UK "required"
    }
    COMPONENTS {
        INTEGER id PK
        INTEGER category_id FK "required"
        TEXT name UK "required"
        INTEGER price_cents "required; >= 0"
        TEXT socket "optional"
        TEXT ram_type "optional"
    }
    BUILDS {
        INTEGER id PK
        INTEGER user_id FK "required"
        TEXT title "required"
        INTEGER budget_cents ">= 0; default 0"
        TEXT created_at "default CURRENT_TIMESTAMP"
    }
    BUILD_ITEMS {
        INTEGER id PK
        INTEGER build_id FK "required; part of unique pair"
        INTEGER component_id FK "required; part of unique pair"
        INTEGER quantity "1 to 20; default 1"
    }
